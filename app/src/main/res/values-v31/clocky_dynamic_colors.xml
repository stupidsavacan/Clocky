<?xml version="1.0" encoding="utf-8"?>
<!-- Material You roles for ThemeMode.MATERIAL_YOU (End-State 5.5). The launcher resolves these with
     its own wallpaper palette and night mode, so no app update is needed when either changes.
     Below API 31 the composer never references them (the design's own palette is shown). -->
<resources>
    <color name="clocky_dyn_primary">@android:color/system_accent1_800</color>
    <color name="clocky_dyn_secondary">@android:color/system_accent2_800</color>
    <color name="clocky_dyn_accent">@android:color/system_accent3_600</color>
    <color name="clocky_dyn_surface">@android:color/system_accent2_100</color>
</resources>
