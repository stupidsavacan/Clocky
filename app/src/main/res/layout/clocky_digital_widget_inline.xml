<?xml version="1.0" encoding="utf-8"?>
<!-- Clocky Digital template: inline row (time, date) (docs/architecture/PHASE_1B_EASY_CREATION.md section 4).
     Same ids as clocky_digital_widget.xml so fit and composer treat every template alike. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clocky_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/clocky_widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/clocky_widget_bg_r16"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/clocky_widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- The row is as tall as its tallest slot; the slots bottom-align inside it. -->
        <LinearLayout
            android:id="@+id/clocky_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/clocky_time_slot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/clocky_date_slot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
