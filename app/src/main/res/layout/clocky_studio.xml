<?xml version="1.0" encoding="utf-8"?>
<!-- Studio, portrait: top bar and the live preview stay pinned; slot chips and the panel scroll below.
     Landscape: layout-land puts the preview and the controls side by side. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clocky_studio_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        layout="@layout/clocky_studio_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        layout="@layout/clocky_config_preview_column"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        layout="@layout/clocky_studio_controls"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
