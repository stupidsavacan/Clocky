<?xml version="1.0" encoding="utf-8"?>
<!-- Studio top bar: back, undo, redo, overflow, save. Every control is 48dp. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="12dp">

    <ImageButton
        android:id="@+id/clocky_studio_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/clocky_quick_tune_back"
        android:src="@drawable/clocky_ic_back"
        app:tint="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/clocky_studio_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/clocky_studio_title"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/clocky_studio_undo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/clocky_studio_undo"
        android:src="@drawable/clocky_ic_undo"
        app:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/clocky_studio_redo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/clocky_studio_redo"
        android:src="@drawable/clocky_ic_redo"
        app:tint="?attr/colorOnSurface" />

    <ImageButton
        android:id="@+id/clocky_studio_more"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/clocky_studio_more"
        android:src="@drawable/clocky_ic_more"
        app:tint="?attr/colorOnSurface" />

    <Button
        android:id="@+id/clocky_studio_save"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/clocky_studio_save" />
</LinearLayout>
