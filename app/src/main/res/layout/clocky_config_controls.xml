            <com.google.android.material.slider.Slider
                android:id="@+id/clocky_four_by_two_time_size_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/clocky_time_size"
                android:valueFrom="1"
                android:valueTo="256"
