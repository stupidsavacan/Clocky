                    android:layout_weight="1"
                    android:text="@string/clocky_date_weight" />

                <TextView
                    android:id="@+id/clocky_four_by_one_date_weight_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="48dp"
                    android:gravity="end"
                    android:text="400" />
