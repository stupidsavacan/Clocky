                android:layout_height="wrap_content"
                android:gravity="end"
                android:minWidth="72dp"
                android:text="0.00 em"
                android:textAppearance="?attr/textAppearanceSubtitle1" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
