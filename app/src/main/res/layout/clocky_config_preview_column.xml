<?xml version="1.0" encoding="utf-8"?>
<!-- Editor preview column (PreviewHost frame, size-class toggle, degradation notice). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clocky_preview_column"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- PreviewHost: applies the same RemoteViews the widget receives. -->
    <FrameLayout
        android:id="@+id/clocky_preview_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/clocky_preview_backdrop"
        android:contentDescription="@string/clocky_preview_description"
        android:padding="12dp">

        <FrameLayout
            android:id="@+id/clocky_preview_frame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" />
    </FrameLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none">
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/clocky_preview_size_class"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <Button
            android:id="@+id/clocky_preview_strip"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clocky_preview_strip" />

        <Button
            android:id="@+id/clocky_preview_card"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clocky_preview_card" />
        <Button
            android:id="@+id/clocky_preview_square"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clocky_preview_square" />
        <Button
            android:id="@+id/clocky_preview_large"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clocky_preview_large" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/clocky_preview_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="24dp"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:visibility="gone" />
</LinearLayout>
