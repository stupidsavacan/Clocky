<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: the pinned preview would leave the controls only a sliver of height, so preview and
     controls sit side by side and each scrolls on its own. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="horizontal">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true">

        <include
            layout="@layout/clocky_config_preview_column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>

    <include
        layout="@layout/clocky_config_controls"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />
</LinearLayout>
