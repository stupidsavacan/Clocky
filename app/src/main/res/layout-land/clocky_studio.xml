<?xml version="1.0" encoding="utf-8"?>
<!-- Studio, landscape: preview and controls side by side, each scrolling on its own. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clocky_studio_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        layout="@layout/clocky_studio_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true">

            <include
                layout="@layout/clocky_config_preview_column"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>

        <include
            layout="@layout/clocky_studio_controls"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
