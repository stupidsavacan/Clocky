<?xml version="1.0" encoding="utf-8"?>
<!-- Quick Tune, landscape: preview and chips side by side, each scrolling on its own
     (a pinned preview would leave the chips a sliver of height; Phase 1A moto g13 lesson). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/clocky_quick_tune_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        layout="@layout/clocky_quick_tune_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true">

            <include
                layout="@layout/clocky_config_preview_column"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>

        <include
            layout="@layout/clocky_quick_tune_controls"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <include
        layout="@layout/clocky_quick_tune_bottombar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
